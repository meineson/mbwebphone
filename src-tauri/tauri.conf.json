{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeConf",
  "version": "0.1.0",
  "identifier": "cn.mbstudio.meconf",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MeConf",
        "width": 1066,
        "height": 600,
        "alwaysOnTop": true,
        "useHttpsScheme": false,
        "additionalBrowserArgs": "--ignore-certificate-errors"
      }
    ],   
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' blob: data: media:; script-src 'self' 'unsafe-eval' 'unsafe-hashes' 'unsafe-inline'; connect-src *;"    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
