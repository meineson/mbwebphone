{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeConf 咪呼",
  "version": "1.3.3",
  "identifier": "cn.mbstudio.meconf",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MeConf 咪呼",
        "url": "index.html",
        "width": 1066,
        "height": 600,
        "minWidth": 480,
        "minHeight": 640,
        "center": true,
        "alwaysOnTop": true,
        "useHttpsScheme": false
      }
    ],   
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
