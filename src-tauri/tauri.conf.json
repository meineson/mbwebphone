{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mbwebphone",
  "version": "0.1.0",
  "identifier": "cn.mbstudio.mbwebphone",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "mbwebphone",
        "width": 1066,
        "height": 600
      }
    ],    
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' blob: data: media:; script-src 'self' 'unsafe-eval'; connect-src *;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
