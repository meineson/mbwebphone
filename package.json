{
  "name": "mbwebphone",
  "version": "1.2.0",
  "description": "mbwebphone",
  "license": "MIT",
  "author": "meineson",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "dmg": "hdiutil create -volname 'MBWebPhone' -srcfolder './out/mbwebphone-darwin-x64/mbwebphone.app' -ov -format UDZO './out/MBWebPhone.dmg'"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-deb": "^7.8.1",
    "@electron-forge/maker-dmg": "^7.8.1",
    "@electron-forge/maker-rpm": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
    "@electron-forge/plugin-fuses": "^7.8.1",
    "@electron/fuses": "^1.8.0",
    "electron": "^37.2.1"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "config": {
    "forge": {
      "makers": [
        {
          "name": "@electron-forge/maker-deb",
          "config": {
            "options": {
              "maintainer": "meineson",
              "homepage": "https://mbstudio.cn"
            }
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": ["darwin", "win"], 
          "config": {
          }
        },
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "authors": "meineson",
            "description": "mbwebphone"
          }
        }
      ]
    }
  },
  "mac":{
    "extendInfo": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "NSMicrophoneUsageDescription": "需要麦克风进行语音通话。",
      "NSCameraUsageDescription": "需要摄像头进行视频通话。",
      "NSScreenCaptureUsageDescription": "需要录制权限进行桌面分享。",
      "com.apple.security.device.audio-input": true,
      "com.apple.security.device.camera": true
    }
  }
}
